# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
python-embed/          # 便携包用的内嵌 Python（run.bat 优先用它）

# 验证脚本的截图产物（scripts/verify.mjs 默认写这里）
.cache/
shot-*.png
probe-*.png

# 数据快照：来自真实工程（带工程名/轨道名），不入库。
# 想跑前端验证就自己生成一份：
#   python scripts/make-fixture.py <你的工程.cpr|.flp|.rpp>
#   python scripts/make-fixture.py <变速工程.cpr> --out scripts/fixture-project-tempo.json
web/project.json
scripts/fixture-project*.json

# 共享外观设置的落盘副本（服务端 /prefs 写的，含你的配色，每台机器各一份）
web/prefs.json
web/prefs.json.tmp

# run.bat 的本地默认工程路径（每台机器不一样）
default-project.txt

# 借来的参考工程（几十 MB，不入库）
projects/
